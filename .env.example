# Copia este archivo como .env (npm run admin:setup lo crea por ti).

# Puerto del servidor
PORT=5180

# Secreto para firmar la sesión del panel. Obligatorio en producción.
# Genera uno largo y aleatorio; nunca lo publiques.
SESSION_SECRET=

# URL pública del sitio (para canonical, sitemap y Open Graph). Ej: https://paradorlasamericas.com
SITE_URL=
